# Supabase — prefer pooled URL for long-running scraper jobs (transaction mode, port 6543).
# Copy the pooler pattern from web/.env.example (DATABASE_URL with pgbouncer=true).
# Direct connection (port 5432) also works for bulk writes:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Local Docker fallback (optional):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pereira_realestate

# MVP: Pereira-only search (see https://www.fincaraiz.com.co/venta/pereira/risaralda )
LISTING_URL=https://www.fincaraiz.com.co/venta/pereira/risaralda
CITY_DEFAULT=Pereira
DEPARTMENT_DEFAULT=Risaralda
# Stop after N unique listing cards (set 0 for no limit)
MAX_LISTINGS_PER_RUN=100

# Placeholder: listing is a "deal" if price/m² is at least this % below neighborhood (or city) average
DEAL_THRESHOLD_PCT=15

# Extra politeness (seconds between major actions — scraper may run a long time)
MIN_DELAY_SEC=2.5
MAX_DELAY_SEC=8.0

# Continue pagination from this page number (default 1)
START_PAGE=1

# Multi-city / multi-URL: see scrape_manifest.json and run:
#   python run_scrape_manifest.py
