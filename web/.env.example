# Supabase — pooled URL for Next.js runtime (transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — direct URL for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Local Docker fallback (optional):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pereira_realestate?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/pereira_realestate?schema=public"

# Public site URL for sitemap, canonical tags, and Open Graph (no trailing slash)
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Email (Resend) — optional in dev; without RESEND_API_KEY confirm links log to the server console
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ClaraCasas <alertas@yourdomain.com>"
# CRON_SECRET="random-long-secret-for-digest-cron"
