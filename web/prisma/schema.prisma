generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Listing {
  id                    String   @id @default(uuid()) @db.Uuid
  externalId            String   @unique @map("external_id")
  title                 String
  priceCop              BigInt   @map("price_cop")
  areaM2                Float    @map("area_m2")
  estrato               Int?
  neighborhood          String?
  neighborhoodRaw       String?   @map("neighborhood_raw")
  conjunto              String?
  city                  String   @default("Pereira")
  cityId                String?  @map("city_id")
  citySlug              String?  @map("city_slug")
  department            String   @default("Risaralda")
  departmentSlug        String?  @map("department_slug")
  pricePerM2            Float?   @map("price_per_m2")
  pricePerM2Built       Float?   @map("price_per_m2_built")
  pricePerM2Terrain     Float?   @map("price_per_m2_terrain")
  dealScore             Float?   @map("deal_score")
  url                   String
  imageUrl              String?  @map("image_url")
  dateScraped           DateTime @map("date_scraped")
  isDeal                Boolean  @default(false) @map("is_deal")
  isActive              Boolean  @default(true) @map("is_active")
  propertyType          String?  @map("property_type")
  operationType         String?  @map("operation_type")
  areaBuiltM2           Float?   @map("area_built_m2")
  areaTerrainM2         Float?   @map("area_terrain_m2")
  areaTerraceM2         Float?   @map("area_terrace_m2")
  areaPrivateM2         Float?   @map("area_private_m2")
  pricePerM2Private     Float?   @map("price_per_m2_private")
  description           String?  @db.Text
  garage                Int?
  floor                 Int?
  antiquity             Int?
  acceptsBarter         Boolean  @default(false) @map("accepts_barter")
  constructionState     String?  @map("construction_state") @db.VarChar(50)
  ownerId               BigInt?  @map("owner_id")
  ownerName             String?  @map("owner_name") @db.VarChar(200)
  ownerType             String?  @map("owner_type") @db.VarChar(50)
  ownerParticular       Boolean? @map("owner_particular")
  neighborhoodSourceId  String?  @map("neighborhood_source_id") @db.VarChar(120)
  zoneName              String?  @map("zone_name") @db.VarChar(100)
  communeName           String?  @map("commune_name") @db.VarChar(100)
  facilities            Json?
  imageCount            Int?     @map("image_count")
  priceAdminIncluded    BigInt?  @map("price_admin_included")
  highlight             Int?
  relevance             Float?
  paidQuota             Boolean? @map("paid_quota")
  isProject             Boolean  @default(false) @map("is_project")
  areaMismatchFlag      Boolean  @default(false) @map("area_mismatch_flag")
  terraceHeavyFlag      Boolean  @default(false) @map("terrace_heavy_flag")
  bedrooms              Int?
  bathrooms             Int?
  rooms                 Int?
  adminFeeCop           BigInt?  @map("admin_fee_cop")
  currencySymbol        String?  @map("currency_symbol")
  latitude              Float?
  longitude             Float?
  locationPath          Json?    @map("location_path")
  sourceCreatedAt       DateTime? @map("source_created_at")
  sourceUpdatedAt       DateTime? @map("source_updated_at")
  qualityFlags          Json?    @map("quality_flags")
  dataCompletenessScore Float?   @map("data_completeness_score")
  sourceFingerprint     String?  @map("source_fingerprint")
  firstSeenAt           DateTime @default(now()) @map("first_seen_at")
  lastSeenAt            DateTime @default(now()) @map("last_seen_at")
  lastChangedAt         DateTime? @map("last_changed_at")
  timesSeen             Int      @default(1) @map("times_seen")

  priceEvents           ListingPriceEvent[]

  @@index([neighborhood])
  @@index([conjunto])
  @@index([city])
  @@index([cityId])
  @@index([citySlug])
  @@index([estrato])
  @@index([dateScraped])
  @@index([propertyType])
  @@index([sourceUpdatedAt])
  @@index([lastSeenAt])
  @@index([isActive])
  @@index([acceptsBarter])
  @@index([zoneName])
  @@index([ownerId])
  @@index([areaPrivateM2])
  @@index([sourceFingerprint])
  @@index([latitude, longitude])
  @@map("listings")
}

model ListingPriceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  externalId String   @map("external_id")
  priceCop   BigInt   @map("price_cop")
  recordedAt DateTime @default(now()) @map("recorded_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@index([externalId, recordedAt])
  @@map("listing_price_events")
}

model MonthlyMarketSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  month      DateTime @db.Date
  city       String
  sample     Int
  medianPpm2 Float?   @map("median_ppm2")
  p25Ppm2    Float?   @map("p25_ppm2")
  p75Ppm2    Float?   @map("p75_ppm2")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz

  @@unique([month, city])
  @@index([city, month])
  @@map("monthly_market_snapshots")
}

model Subscriber {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  source     String?
  city       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([source])
  @@index([city])
  @@map("subscribers")
}
