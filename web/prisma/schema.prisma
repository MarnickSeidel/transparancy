generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Listing {
  id                    String   @id @default(uuid()) @db.Uuid
  externalId            String   @unique @map("external_id")
  title                 String
  priceCop              BigInt   @map("price_cop")
  areaM2                Float    @map("area_m2")
  estrato               Int?
  neighborhood          String?
  neighborhoodRaw       String?   @map("neighborhood_raw")
  conjunto              String?
  city                  String   @default("Pereira")
  cityId                String?  @map("city_id")
  citySlug              String?  @map("city_slug")
  department            String   @default("Risaralda")
  departmentSlug        String?  @map("department_slug")
  pricePerM2            Float?   @map("price_per_m2")
  pricePerM2Built       Float?   @map("price_per_m2_built")
  pricePerM2Terrain     Float?   @map("price_per_m2_terrain")
  dealScore             Float?   @map("deal_score")
  url                   String
  imageUrl              String?  @map("image_url")
  dateScraped           DateTime @map("date_scraped")
  isDeal                Boolean  @default(false) @map("is_deal")
  isActive              Boolean  @default(true) @map("is_active")
  propertyType          String?  @map("property_type")
  operationType         String?  @map("operation_type")
  areaBuiltM2           Float?   @map("area_built_m2")
  areaTerrainM2         Float?   @map("area_terrain_m2")
  areaTerraceM2         Float?   @map("area_terrace_m2")
  areaPrivateM2         Float?   @map("area_private_m2")
  pricePerM2Private     Float?   @map("price_per_m2_private")
  description           String?  @db.Text
  address               String?  @db.VarChar(500)
  technicalSheet        Json?    @map("technical_sheet")
  garage                Int?
  floor                 Int?
  antiquity             Int?
  acceptsBarter         Boolean  @default(false) @map("accepts_barter")
  constructionState     String?  @map("construction_state") @db.VarChar(50)
  ownerId               BigInt?  @map("owner_id")
  ownerName             String?  @map("owner_name") @db.VarChar(200)
  ownerType             String?  @map("owner_type") @db.VarChar(50)
  ownerParticular       Boolean? @map("owner_particular")
  /// 'particular' | 'inmobiliaria' | 'desarrollador' (derived from FR owner.particular / owner.type)
  sellerType            String?  @map("seller_type") @db.VarChar(30)
  neighborhoodSourceId  String?  @map("neighborhood_source_id") @db.VarChar(120)
  zoneName              String?  @map("zone_name") @db.VarChar(100)
  communeName           String?  @map("commune_name") @db.VarChar(100)
  facilities            Json?
  imageCount            Int?     @map("image_count")
  priceAdminIncluded    BigInt?  @map("price_admin_included")
  highlight             Int?
  relevance             Float?
  paidQuota             Boolean? @map("paid_quota")
  isProject             Boolean  @default(false) @map("is_project")
  areaMismatchFlag      Boolean  @default(false) @map("area_mismatch_flag")
  terraceHeavyFlag      Boolean  @default(false) @map("terrace_heavy_flag")
  bedrooms              Int?
  bathrooms             Int?
  rooms                 Int?
  adminFeeCop           BigInt?  @map("admin_fee_cop")
  currencySymbol        String?  @map("currency_symbol")
  latitude              Float?
  longitude             Float?
  locationPath          Json?    @map("location_path")
  sourceCreatedAt       DateTime? @map("source_created_at")
  sourceUpdatedAt       DateTime? @map("source_updated_at")
  qualityFlags          Json?    @map("quality_flags")
  dataCompletenessScore Float?   @map("data_completeness_score")
  sourceFingerprint     String?  @map("source_fingerprint")
  firstSeenAt           DateTime @default(now()) @map("first_seen_at")
  lastSeenAt            DateTime @default(now()) @map("last_seen_at")
  lastChangedAt         DateTime? @map("last_changed_at")
  timesSeen             Int      @default(1) @map("times_seen")

  priceEvents           ListingPriceEvent[]

  @@index([neighborhood])
  @@index([conjunto])
  @@index([city])
  @@index([cityId])
  @@index([citySlug])
  @@index([estrato])
  @@index([dateScraped])
  @@index([propertyType])
  @@index([sourceUpdatedAt])
  @@index([lastSeenAt])
  @@index([isActive])
  @@index([acceptsBarter])
  @@index([dealScore])
  @@index([zoneName])
  @@index([ownerId])
  @@index([sellerType])
  @@index([areaPrivateM2])
  @@index([sourceFingerprint])
  @@index([latitude, longitude])
  @@map("listings")
}

model ListingPriceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  externalId String   @map("external_id")
  priceCop   BigInt   @map("price_cop")
  recordedAt DateTime @default(now()) @map("recorded_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@index([externalId, recordedAt])
  @@map("listing_price_events")
}

model MonthlyMarketSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  month      DateTime @db.Date
  city       String
  sample     Int
  medianPpm2 Float?   @map("median_ppm2")
  p25Ppm2    Float?   @map("p25_ppm2")
  p75Ppm2    Float?   @map("p75_ppm2")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz

  @@unique([month, city])
  @@index([city, month])
  @@map("monthly_market_snapshots")
}

// Thin market facts for aged inactive listings (trends/reactivation without full row).
model ListingMarketFact {
  id               String    @id @default(uuid()) @db.Uuid
  externalId       String    @unique @map("external_id")
  city             String
  neighborhood     String?
  estrato          Int?
  propertyType     String?   @map("property_type")
  operationType    String?   @map("operation_type")
  priceCop         BigInt    @map("price_cop")
  areaM2           Float     @map("area_m2")
  pricePerM2       Float     @map("price_per_m2")
  sourceCreatedAt  DateTime? @map("source_created_at")
  firstSeenAt      DateTime  @map("first_seen_at")
  lastSeenAt       DateTime  @map("last_seen_at")
  latitude         Float?
  longitude        Float?
  ownerId          BigInt?   @map("owner_id")
  sellerType       String?   @map("seller_type") @db.VarChar(30)
  archivedAt       DateTime  @default(now()) @map("archived_at") @db.Timestamptz

  @@index([city, lastSeenAt])
  @@index([city, neighborhood])
  @@index([lastSeenAt])
  @@index([sellerType])
  @@map("listing_market_facts")
}

model Subscriber {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  source     String?
  city       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([source])
  @@index([city])
  @@map("subscribers")
}

enum EmailContactStatus {
  pending
  active
  unsubscribed
}

enum EmailList {
  deals_city
  deals_neighborhood
  price_drops_city
  market_monthly_city
  market_quarterly_colombia
}

model EmailContact {
  id               String             @id @default(uuid()) @db.Uuid
  email            String             @unique
  locale           String             @default("es")
  status           EmailContactStatus @default(pending)
  source           String?
  confirmToken     String             @unique @map("confirm_token")
  unsubscribeToken String             @unique @map("unsubscribe_token")
  confirmedAt      DateTime?          @map("confirmed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  preferences      EmailPreference[]
  sendLogs         EmailSendLog[]

  @@index([status])
  @@index([createdAt])
  @@map("email_contacts")
}

model EmailPreference {
  id           String    @id @default(uuid()) @db.Uuid
  contactId    String    @map("contact_id") @db.Uuid
  list         EmailList
  city         String?
  neighborhood String?
  active       Boolean   @default(true)
  lastSentAt   DateTime? @map("last_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  contact      EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sendLogs     EmailSendLog[]

  @@unique([contactId, list, city, neighborhood])
  @@index([list, active, city])
  @@map("email_preferences")
}

model EmailSendLog {
  id             String           @id @default(uuid()) @db.Uuid
  contactId      String           @map("contact_id") @db.Uuid
  preferenceId   String?          @map("preference_id") @db.Uuid
  digestKey      String           @map("digest_key")
  sentAt         DateTime         @default(now()) @map("sent_at")
  contact        EmailContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  preference     EmailPreference? @relation(fields: [preferenceId], references: [id], onDelete: SetNull)

  @@unique([contactId, digestKey])
  @@index([digestKey])
  @@map("email_send_logs")
}

model SharedReport {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  payload   Json
  lang      String    @default("es")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@index([createdAt])
  @@map("shared_reports")
}
